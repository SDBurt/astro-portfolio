---
import type { CollectionEntry } from "astro:content";
import BackToPrev from "@/components/back-to-previous.astro";
import FormattedDate from "@/components/formatted-date.astro";
import { readingTime } from "@/lib/utils";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props;
const { data } = entry;
const isProject = entry.collection === "projects";
const links = isProject
  ? [
      { label: "demo", href: entry.data.demoURL },
      { label: "repo", href: entry.data.repoURL },
    ].filter((link): link is { label: string; href: string } => Boolean(link.href))
  : [];
---

<header class="entry-header">
  <BackToPrev href={`/${entry.collection}`}>
    {isProject ? "Back to projects" : "Back to blog"}
  </BackToPrev>

  <p class="entry-header__meta">
    <FormattedDate date={data.date} />
    <span>{readingTime(entry.body ?? "")}</span>
  </p>
  <h1 class="page-title">{data.title}</h1>

  {
    links.length > 0 && (
      <nav class="entry-header__links">
        {links.map((link) => (
          <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
      </nav>
    )
  }
</header>

<style>
  .entry-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: var(--block-gap);
    margin-bottom: calc(var(--block-gap) * 1.5);
    border-bottom: 1px solid var(--color-border);
  }

  .entry-header :global(.back-link) {
    margin-bottom: 0.75rem;
  }

  .entry-header__meta {
    display: flex;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: var(--color-muted-foreground);
  }

  .entry-header__meta > * + *::before {
    content: "•";
    margin: 0 0.5rem;
  }

  .entry-header__links {
    display: flex;
    gap: 1.5rem;
  }
</style>
