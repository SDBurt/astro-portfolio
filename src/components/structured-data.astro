---
import { SITE, HOME, AUTHOR, OG_IMAGE, SOCIALS } from "@/config/site";

interface Props {
  type: "website" | "article" | "person" | "portfolio";
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  datePublished?: Date;
  dateModified?: Date;
  author?: string;
  tags?: string[];
}

const {
  type,
  title = SITE.NAME,
  description = HOME.DESCRIPTION,
  image = OG_IMAGE,
  url = Astro.url.href,
  datePublished,
  dateModified,
  author = AUTHOR.NAME,
  tags = [],
} = Astro.props;

const baseUrl = Astro.site?.href || "https://www.sdburt.com";
const imageUrl = new URL(image, baseUrl).href;
const logoUrl = new URL("/android-chrome-192x192.png", baseUrl).href;
const profiles = SOCIALS.map((social) => social.HREF);

let structuredData: Record<string, unknown> = {
  "@context": "https://schema.org",
  // `name` is the entity's own name, not the page title: for a Person node the
  // page title ("About | SDBurt") is simply wrong.
  "@type": type === "website" ? "WebSite" : type === "article" ? "BlogPosting" : type === "person" ? "Person" : "CreativeWork",
  name: type === "person" ? author : title,
  description,
  url,
  image: imageUrl,
};

if (type === "website") {
  structuredData = {
    ...structuredData,
    // `publisher` is the property WebSite expects; `author` was wrong here and
    // a SearchAction is meaningless on a site with no search.
    publisher: {
      "@type": "Person",
      name: author,
      url: baseUrl,
      jobTitle: AUTHOR.JOB_TITLE,
      worksFor: {
        "@type": "Organization",
        name: AUTHOR.WORKS_FOR,
      },
      sameAs: profiles,
    },
  };
} else if (type === "article") {
  structuredData = {
    ...structuredData,
    headline: title,
    datePublished: datePublished?.toISOString(),
    dateModified: dateModified?.toISOString() || datePublished?.toISOString(),
    author: {
      "@type": "Person",
      name: author,
      url: baseUrl,
      sameAs: profiles,
    },
    // Article rich results expect an Organization publisher with a logo.
    publisher: {
      "@type": "Organization",
      name: author,
      url: baseUrl,
      logo: {
        "@type": "ImageObject",
        url: logoUrl,
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": url,
    },
    keywords: tags.join(", "),
  };
} else if (type === "person") {
  structuredData = {
    ...structuredData,
    "@type": "Person",
    givenName: author.split(" ")[0],
    familyName: author.split(" ").slice(1).join(" "),
    jobTitle: AUTHOR.JOB_TITLE,
    worksFor: {
      "@type": "Organization",
      name: AUTHOR.WORKS_FOR,
    },
    alumniOf: AUTHOR.ALUMNI_OF.map((school) => ({
      "@type": "EducationalOrganization",
      name: school,
    })),
    knowsAbout: AUTHOR.KNOWS_ABOUT,
    sameAs: profiles,
  };
}

// Remove undefined values
structuredData = JSON.parse(JSON.stringify(structuredData));
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />