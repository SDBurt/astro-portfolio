---
import { getCollection } from "astro:content";
import Container from "@/components/container.astro";
import EntryRows from "@/components/entry-rows.astro";
import PageLayout from "@/layouts/page-layout.astro";
import { SITE, AUTHOR, HOME, SOCIALS } from "@/config/site";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container wide>
    <section class="hero">
      <div class="hero__field">
        <span class="hero__role">{HOME.TITLE}</span>
        <h1 class="hero__title">{AUTHOR.NAME}</h1>
      </div>

      <div class="hero__side">
        <p class="hero__lede">
          Software engineer specializing in <strong>full stack development</strong> and <strong>data engineering</strong>.
          I build scalable systems that process data efficiently and create AI-powered solutions
          that solve real-world problems.
        </p>
        <p class="hero__more">
          Currently working at <strong>Consumer Genius</strong> on data pipelines and analytics platforms.
          Previously led the technical development of <strong>Fire AI</strong> at Hummingbird Drones, an ML platform
          that detects wildfires from drone imagery and creates geo-referenced pdf maps.
        </p>
        <div class="hero__actions">
          <a class="button" href={`mailto:${SITE.EMAIL}`}>Email me</a>
          <a class="text-link" href="/about">About me</a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="latest-posts">
      <h2 id="latest-posts" class="section__title">Latest posts</h2>
      <div>
        <EntryRows entries={blog} />
        <a class="section__more quiet-link" href="/blog">See all posts</a>
      </div>
    </section>

    <section class="section" aria-labelledby="recent-projects">
      <h2 id="recent-projects" class="section__title">Recent projects</h2>
      <div>
        <EntryRows entries={projects} date="year" />
        <a class="section__more quiet-link" href="/projects">See all projects</a>
      </div>
    </section>

    <section class="section" aria-labelledby="contact">
      <h2 id="contact" class="section__title">Contact</h2>
      <div class="contact">
        <p>Get in touch via email or social media.</p>
        <p class="contact__links">
          {
            SOCIALS.map((social) => (
              <a
                class="text-link"
                href={social.HREF}
                target="_blank"
                rel="noreferrer"
                aria-label={`${SITE.NAME} on ${social.NAME}`}
              >
                {social.NAME}
              </a>
            ))
          }
          <a class="text-link" href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
            {SITE.EMAIL}
          </a>
        </p>
      </div>
    </section>
  </Container>
</PageLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: calc(var(--block-gap) * 1.5);
    margin-bottom: var(--section-gap);
  }

  .hero__field {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(15rem, 11rem + 14vw, 24rem);
    padding: var(--field-pad);
    border-radius: var(--radius-field);
    background-color: var(--color-field);
    color: var(--color-field-foreground);
  }

  .hero__role {
    font-size: 0.9375rem;
    color: var(--color-field-muted);
  }

  .hero__title {
    font-family: var(--font-family-serif);
    font-size: clamp(3rem, 2rem + 4vw, 5rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  /* Both paragraphs share the serif so they read as one block; emphasis is
     carried by colour rather than weight, which keeps long lines calm */
  .hero__lede,
  .hero__more {
    max-width: 34rem;
    font-family: var(--font-family-serif);
    text-wrap: pretty;
  }

  .hero__lede {
    font-size: clamp(1.25rem, 1.1rem + 0.45vw, 1.45rem);
    line-height: 1.5;
    color: var(--color-foreground);
  }

  .hero__more {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }

  .hero__lede strong,
  .hero__more strong {
    font-weight: inherit;
    color: var(--color-brand);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .contact {
    padding-top: 1rem;
    color: var(--color-muted-foreground);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-top: 0.75rem;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
