---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/page-layout.astro";
import Container from "@/components/container.astro";
import PageIntro from "@/components/page-intro.astro";
import WorkTimeline from "@/components/work-timeline.astro";
import { WORK } from "@/config/site";

const work = (await getCollection("work")).sort(
  (a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf()
);
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <Container wide>
    <PageIntro title={WORK.TITLE} />
    <WorkTimeline entries={work} detailed />
  </Container>
</PageLayout>
