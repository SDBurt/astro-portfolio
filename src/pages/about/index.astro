---
import { getCollection } from "astro:content";
import Container from "@/components/container.astro";
import PageLayout from "@/layouts/page-layout.astro";
import PageIntro from "@/components/page-intro.astro";
import WorkTimeline from "@/components/work-timeline.astro";
import { SITE, ABOUT, SOCIALS } from "@/config/site";

const work = (await getCollection("work"))
  .sort((a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf())
  .slice(0, SITE.NUM_WORKS_ON_ABOUT);
---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION} type="person">
  <Container wide>
    <PageIntro title={ABOUT.TITLE} />

    <article class="about-prose">
      <p>
        Hi, I'm Sean Burt, a software engineering graduate specializing in
        AI from the University of Victoria. I started my career at
        Hummingbird Drones, where I led the development of the Fire AI
        project, managing the web app, cloud infrastructure, and machine
        learning components. I now work at Consumer Genius, where I work
        mainly on the data pipelines and data engineering related projects.
      </p>
      <p>
        I have a strong passion for web development, machine learning, data
        engineering, and data science. I thrive in collaborative environments, ensuring
        everyone's contributions are valued. In my spare time, I enjoy
        working on personal projects, building out a homelab, and
        taking online courses to expand my knowledge.
      </p>
      <p>
        With a focus on continuous learning and innovation, I bring
        dedication and a collaborative spirit to every project. Please take
        a moment to see my work experience below.
      </p>
    </article>

    <section class="section about-section" aria-labelledby="work-experience">
      <h2 id="work-experience" class="section__title">Work Experience</h2>
      <div>
        <WorkTimeline entries={work} detailed />
        <a class="section__more quiet-link" href="/work">See all work</a>
      </div>
    </section>

    <section class="section" aria-labelledby="lets-connect">
      <h2 id="lets-connect" class="section__title">Let's Connect</h2>
      <div class="about-contact">
        <p>
          If you want to get in touch with me about something or just to say
          hi, reach out on social media or send me an email.
        </p>
        <p class="about-contact__links">
          {
            SOCIALS.map((social) => (
              <a
                class="text-link"
                href={social.HREF}
                target="_blank"
                rel="noreferrer"
                aria-label={`${SITE.NAME} on ${social.NAME}`}
              >
                {social.NAME}
              </a>
            ))
          }
          <a class="text-link" href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
            {SITE.EMAIL}
          </a>
        </p>
      </div>
    </section>
  </Container>
</PageLayout>

<style>
  .about-prose {
    max-width: 42rem;
    font-size: clamp(1.15rem, 1rem + 0.4vw, 1.3rem);
  }

  .about-section {
    margin-top: var(--section-gap);
  }

  .about-contact {
    padding-top: 1rem;
    max-width: 38rem;
    color: var(--color-muted-foreground);
  }

  .about-contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-top: 0.75rem;
  }
</style>
