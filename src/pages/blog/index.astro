---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@/layouts/page-layout.astro";
import Container from "@/components/container.astro";
import EntryRows from "@/components/entry-rows.astro";
import PageIntro from "@/components/page-intro.astro";
import { BLOG } from "@/config/site";

const data = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const posts = data.reduce<Record<string, CollectionEntry<"blog">[]>>((acc, post) => {
  const year = post.data.date.getFullYear().toString();
  acc[year] ??= [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(posts).sort((a, b) => Number(b) - Number(a));
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container wide>
    <PageIntro title={BLOG.TITLE} />
    {
      years.map((year) => (
        <section class="section" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`} class="section__title">{year}</h2>
          <EntryRows entries={posts[year]} />
        </section>
      ))
    }
  </Container>
</PageLayout>
